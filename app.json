{
  "expo": {
    "name": "Bol",
    "slug": "bol",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "bol",
    "userInterfaceStyle": "light",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "dev.rohitsingh.bol",
      "entitlements": {
        "com.apple.security.application-groups": ["group.dev.rohitsingh.bol"]
      },
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Bol uses the microphone to turn your speech into text."
      }
    },
    "android": {
      "package": "dev.rohitsingh.bol",
      "adaptiveIcon": {
        "backgroundColor": "#F4EFE6",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": ["android.permission.RECORD_AUDIO"]
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-dev-client",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F4EFE6",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Bol uses the microphone to turn your speech into text.",
          "recordAudioAndroid": true
        }
      ],
      "@bacons/apple-targets",
      "./plugins/withBolIme"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
